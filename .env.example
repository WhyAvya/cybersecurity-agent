APP_ENV=local
LOG_LEVEL=INFO
DATA_ROOT=data
ARTIFACT_ROOT=artifacts
REPORT_DIR=artifacts/reports
EVALUATION_DIR=artifacts/evaluation
# Local Windows Ollama mode for current development/evaluation:
OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# Docker Compose Ollama mode for reproducibility testing:
# OLLAMA_BASE_URL=http://ollama:11434
#
# Enable exactly one OLLAMA_BASE_URL mode at a time.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_MAX_RETRIES=2
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
OLLAMA_NUM_CTX=2048
SEMGREP_BINARY=semgrep
SEMGREP_CONFIG=p/python
SEMGREP_TIMEOUT_SECONDS=120
CONTEXT_LINES_BEFORE=10
CONTEXT_LINES_AFTER=10
MAX_FILE_SIZE_BYTES=1000000
MAX_FILES_PER_SCAN=5000
ALLOWED_EXTENSIONS=.py
EXCLUDED_DIRECTORIES=.git,.venv,venv,__pycache__,node_modules,artifacts,results,reports
HYBRID_ACCEPT_CONFIDENCE=0.60
HIGH_PRIORITY_CONFIDENCE=0.85
MAX_AGENT_ITERATIONS=3
EVALUATION_SEED=42
LLM_BASELINE_SAMPLE_SIZE=100
CONSISTENCY_SAMPLE_SIZE=30
PROMPT_SENSITIVITY_SAMPLE_SIZE=30
